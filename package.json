{
  "name": "anti-shishan-kit",
  "version": "0.1.0",
  "description": "Governance kit for AI-assisted development: executable gates, decision notes, ratchet baselines, and constitution templates.",
  "type": "module",
  "bin": {
    "anti-shishan": "dist/cli/index.js",
    "anti-shishan-kit": "dist/cli/index.js"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "keywords": [
    "agents-md",
    "ai-development",
    "governance",
    "code-quality",
    "cli",
    "agent-notes"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "check": "npm run build && node dist/cli/index.js check",
    "anti-shishan": "node dist/cli/index.js",
    "prepublishOnly": "npm run coverage && npm run build"
  },
  "files": [
    "dist",
    "templates",
    "NOTICE"
  ],
  "dependencies": {
    "mdast-util-from-markdown": "^2.0.2",
    "mdast-util-gfm": "^3.1.0",
    "micromark-extension-gfm": "^3.0.0",
    "minimatch": "^10.0.1",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.2.4"
  }
}
