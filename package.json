{
  "name": "nodrift-cli",
  "version": "0.2.1",
  "description": "Governance kit for AI-assisted development: executable gates, decision notes, ratchet baselines, and constitution templates.",
  "type": "module",
  "bin": {
    "nodrift": "dist/cli/index.js"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tymolu233/nodrift.git"
  },
  "homepage": "https://github.com/tymolu233/nodrift#readme",
  "bugs": {
    "url": "https://github.com/tymolu233/nodrift/issues"
  },
  "keywords": [
    "agents-md",
    "ai-development",
    "governance",
    "code-quality",
    "cli",
    "agent-notes",
    "drift"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "gen:templates": "node scripts/gen-embedded-templates.mjs",
    "build": "npm run gen:templates && tsc -p tsconfig.json",
    "typecheck": "npm run gen:templates && tsc --noEmit",
    "lint": "eslint .",
    "test": "npm run gen:templates && vitest run",
    "coverage": "npm run gen:templates && vitest run --coverage",
    "check": "npm run build && node dist/cli/index.js check",
    "nodrift": "node dist/cli/index.js",
    "prepublishOnly": "npm run coverage && npm run build"
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "dependencies": {
    "mdast-util-from-markdown": "^2.0.2",
    "mdast-util-gfm": "^3.1.0",
    "micromark-extension-gfm": "^3.0.0",
    "minimatch": "^10.0.1",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.2.4"
  }
}
